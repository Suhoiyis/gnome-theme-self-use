layout {

    focus-ring {
        active-color   "#e2c54b"
        inactive-color "#0d150d"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e2c54b"
        inactive-color "#0d150d"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#e2c54b"
        inactive-color "#544600"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e2c54b80"
    }
}

recent-windows {
    highlight {
        active-color "#e2c54b"
        urgent-color "#ffb4ab"
    }
}
